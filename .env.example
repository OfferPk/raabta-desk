# SQLite database path (relative to project root)
DATABASE_PATH=./data/raabta.db

# Reserved for future session signing — unused in MVP (sessions are random UUIDs in DB)
SESSION_SECRET=change-me-to-a-long-random-string

# Cookie Secure flag:
# - unset: Secure when NODE_ENV=production, or when x-forwarded-proto=https
# - COOKIE_SECURE=false — required for local HTTP `npm run build && npm start`
# - COOKIE_SECURE=true  — force Secure (real HTTPS deploys)
COOKIE_SECURE=false

# Node environment
NODE_ENV=development
